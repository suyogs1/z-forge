{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd packages/ui && npm install && npm run build",
  "outputDirectory": "packages/ui/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/mcp/:match*",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/workflow/:match*",
      "destination": "/api/workflow"
    }
  ],
  "headers": [
    {
      "source": "/api/mcp",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    },
    {
      "source": "/api/workflow",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ]
}
