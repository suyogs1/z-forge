{
  "_comment": "CUST.REPORT.FILE — Customer Report File dataset schema descriptor",
  "_synthetic": true,
  "_organization": "ZENITH BANK (fictional)",
  "dataset_name": "ZENITH.CUST.REPORT.FILE",
  "description": "Customer Report File — generated by CUSTRPT program",
  "dcb": {
    "recfm": "FBA",
    "lrecl": 133,
    "blksize": 5320
  },
  "record_name": "REPORT-RECORD",
  "program": "CUSTRPT.CBL",
  "fields": [
    {
      "name": "RPT-LINE-TYPE",
      "type": "X",
      "length": 1,
      "offset": 0,
      "pic": "PIC X",
      "description": "H=Header, D=Detail, T=Trailer"
    },
    {
      "name": "RPT-CUSTOMER-ID",
      "type": "X",
      "length": 8,
      "offset": 1,
      "pic": "PIC X(8)",
      "description": "Customer ID copied from CUST.MASTER.FILE — must match CUSTOMER-ID length",
      "source_field": "CUSTOMER-ID"
    },
    {
      "name": "RPT-FILLER-1",
      "type": "X",
      "length": 1,
      "offset": 9,
      "pic": "PIC X",
      "description": "Space separator"
    },
    {
      "name": "RPT-CUSTOMER-NAME",
      "type": "X",
      "length": 30,
      "offset": 10,
      "pic": "PIC X(30)",
      "description": "Customer name"
    },
    {
      "name": "RPT-FILLER-2",
      "type": "X",
      "length": 1,
      "offset": 40,
      "pic": "PIC X",
      "description": "Space separator"
    },
    {
      "name": "RPT-STATUS",
      "type": "X",
      "length": 1,
      "offset": 41,
      "pic": "PIC X",
      "description": "Customer status"
    },
    {
      "name": "RPT-FILLER-3",
      "type": "X",
      "length": 1,
      "offset": 42,
      "pic": "PIC X",
      "description": "Space separator"
    },
    {
      "name": "RPT-OPEN-DATE",
      "type": "X",
      "length": 8,
      "offset": 43,
      "pic": "PIC X(8)",
      "description": "Account open date"
    },
    {
      "name": "RPT-FILLER",
      "type": "X",
      "length": 82,
      "offset": 51,
      "pic": "PIC X(82)",
      "description": "Remaining report line area"
    }
  ],
  "notes": [
    "RPT-CUSTOMER-ID (length 8, offset 1) must be kept in sync with CUSTOMER-ID in CUSTMAST.CPY",
    "After CUSTOMER-ID expands to PIC X(12), RPT-CUSTOMER-ID must expand and all offsets after it shift by +4",
    "The AFP output CUSTRPT.AFP is derived from this file"
  ]
}
